# Multi-stage Dockerfile for Spring Boot microservices (Java 21).
# Build from the repository root:
# docker build -f docker/Dockerfile.service --build-arg SERVICE_MODULE=identity-service -t marketplace/identity-service .
ARG SERVICE_MODULE

FROM maven:3.9-eclipse-temurin-21-alpine AS builder
WORKDIR /build
ARG SERVICE_MODULE

COPY pom.xml ./
COPY common-library/ common-library/
COPY gateway-service/ gateway-service/
COPY identity-service/ identity-service/
COPY product-service/ product-service/
COPY seller-service/ seller-service/
COPY buyer-service/ buyer-service/
COPY category-service/ category-service/
COPY inventory-service/ inventory-service/
COPY pricing-service/ pricing-service/
COPY workflow-service/ workflow-service/
COPY notification-service/ notification-service/
COPY search-service/ search-service/
COPY ai-service/ ai-service/
COPY audit-service/ audit-service/
COPY subscription-service/ subscription-service/
COPY report-service/ report-service/
COPY admin-service/ admin-service/

# Retry transient Maven Central/network failures instead of failing the image build immediately.
RUN mvn -B -ntp -Dmaven.wagon.http.retryHandler.count=5 -pl "${SERVICE_MODULE}" -am package -DskipTests

FROM eclipse-temurin:21-jre-alpine AS runtime
WORKDIR /app
ARG SERVICE_MODULE
RUN addgroup -S marketplace && adduser -S marketplace -G marketplace
COPY --from=builder /build/${SERVICE_MODULE}/target/*.jar /app/app.jar
USER marketplace
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD wget -qO- "http://localhost:${SERVER_PORT:-8080}/actuator/health/liveness" || exit 1
ENTRYPOINT ["java", "-XX:+UseContainerSupport", "-XX:MaxRAMPercentage=75.0", "-jar", "/app/app.jar"]
