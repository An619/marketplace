# Copy to terraform.tfvars and replace the example CIDR with your public IP /32.
# Find your public IPv4 address using a trusted IP-check service before applying.
aws_region      = "ap-south-1"
environment     = "dev"
cluster_name    = "marketplace"
kubernetes_version = "1.33"
vpc_cidr        = "10.40.0.0/16"

# Documentation-only example range. Replace with your actual public IP /32.
cluster_endpoint_public_access_cidrs = ["203.0.113.10/32"]

node_instance_types = ["t3.medium"]
node_min_size       = 1
node_max_size       = 2
node_desired_size   = 1

tags = {
  Owner = "devops-lab"
}
